From b8fa9395d9a1a64f4c792d68904214c338519077 Mon Sep 17 00:00:00 2001
From: bleugreen <mitchell5799@gmail.com>
Date: Thu, 22 Oct 2026 15:59:23 -0700
Subject: [PATCH 1/6] [Build] runner budget: book a routed click as two user
 events

meterDispatch books each action at the browser client's user-event cost
(userEventsOf, shared with the in-page runtime): a routable click without
route:false is MOVE_OPCLICK + op, two events; everything else one.
USER_EVENTS_PER_TICK is unchanged. Tests at the 5-event edge and for the
carry a 6-event tick leaves in the next window.
---
 speedrun/runner/budget.test.ts | 58 ++++++++++++++++++++++++++++++++++
 speedrun/runner/budget.ts      | 35 ++++++++++++--------
 2 files changed, 79 insertions(+), 14 deletions(-)

diff --git a/speedrun/runner/budget.test.ts b/speedrun/runner/budget.test.ts
index 243843c68adce669c55b7f3d6a985367076d03a3..d766701ea6bbb451ccfc4fdf945720a645747467 100644
--- a/speedrun/runner/budget.test.ts
+++ b/speedrun/runner/budget.test.ts
@@ -66,6 +66,64 @@ describe('meterDispatch', () => {
         expect(w.snapshot()).toMatchObject({ pending: 0, sent: 0 });
     });
 
+    const dispatch = (sdk: FakeSdk, action: Record<string, unknown>) => (sdk as unknown as { sendAction(a: unknown): Promise<unknown> }).sendAction({ reason: 'x', ...action });
+    const npcClick = { type: 'interactNpc', npcIndex: 12, optionIndex: 3 };
+
+    test('a routed click books two user events, an unrouted one (route: false) one', async () => {
+        const sdk = new FakeSdk();
+        const w = new TickWindow(100, 0);
+        meterDispatch(sdk, w);
+        const routed = dispatch(sdk, npcClick);
+        expect(w.snapshot()).toMatchObject({ pending: 2, sent: 0, free: 3 });
+        await routed;
+        expect(w.snapshot()).toMatchObject({ pending: 0, sent: 2, free: 3 });
+        await dispatch(sdk, { ...npcClick, route: false });
+        await dispatch(sdk, { type: 'interactLoc', x: 1, z: 2, locId: 3, optionIndex: 1 });
+        await dispatch(sdk, { type: 'clickComponent', componentId: 1 });
+        expect(w.snapshot()).toMatchObject({ sent: 6, free: 0 });
+    });
+
+    test('four Charges and a routed click are six events: the window is spent and one carries', async () => {
+        const sdk = new FakeSdk();
+        const w = new TickWindow(100, 0);
+        meterDispatch(sdk, w);
+        for (let i = 0; i < 3; i++) await dispatch(sdk, { type: 'clickComponent', componentId: 1 });
+        await dispatch(sdk, npcClick);
+        // the 5-event edge: three Charges and a routed click fill the tick exactly
+        expect(w.snapshot()).toMatchObject({ sent: 5, carry: 0, free: 0 });
+        w.observe(101, 0);
+        expect(w.snapshot()).toMatchObject({ sent: 0, carry: 0, free: 5 });
+
+        for (let i = 0; i < 4; i++) await dispatch(sdk, { type: 'clickComponent', componentId: 1 });
+        await dispatch(sdk, npcClick);
+        expect(w.snapshot()).toMatchObject({ sent: 6, free: 0 });
+        // the server decodes 5 on its next tick; the click's op waits a tick and spends the next window
+        w.observe(102, 0);
+        expect(w.snapshot()).toMatchObject({ sent: 0, carry: 1, free: 4 });
+        w.observe(103, 0);
+        expect(w.snapshot()).toMatchObject({ carry: 0, free: 5 });
+    });
+
+    test('four Charges and an unrouted click are five events: nothing carries', async () => {
+        const sdk = new FakeSdk();
+        const w = new TickWindow(100, 0);
+        meterDispatch(sdk, w);
+        for (let i = 0; i < 4; i++) await dispatch(sdk, { type: 'clickComponent', componentId: 1 });
+        await dispatch(sdk, { ...npcClick, route: false });
+        expect(w.snapshot()).toMatchObject({ sent: 5, free: 0 });
+        w.observe(101, 0);
+        expect(w.snapshot()).toMatchObject({ carry: 0, free: 5 });
+    });
+
+    test('a routed click still pending spends both its events', () => {
+        const sdk = new FakeSdk();
+        const w = new TickWindow(100, 0);
+        meterDispatch(sdk, w);
+        for (let i = 0; i < 3; i++) void dispatch(sdk, { type: 'clickComponent', componentId: 1 });
+        void dispatch(sdk, npcClick);
+        expect(w.snapshot()).toMatchObject({ pending: 5, sent: 0, free: 0 });
+    });
+
     test('an SDK without the dispatch point is refused, not silently uncounted', () => {
         expect(() => meterDispatch({}, new TickWindow(0, 0))).toThrow('no sendAction');
     });
diff --git a/speedrun/runner/budget.ts b/speedrun/runner/budget.ts
index 599764fd670517e1c6e879e0c6353da36367063a..97bd435f79a55d3ed8bd721d43f24b8d002d5c30 100644
--- a/speedrun/runner/budget.ts
+++ b/speedrun/runner/budget.ts
@@ -9,16 +9,22 @@
 //
 // - the window is the tick label of the latest published state; a packet sent
 //   while tick N is the latest lands on the server's next tick;
-// - `sent` counts actions acknowledged in this window;
-// - `pending` counts actions dispatched and not yet acknowledged, which are on
-//   their way out and spend this window's budget;
+// - `sent` counts the user events of actions acknowledged in this window;
+// - `pending` counts those of actions dispatched and not yet acknowledged, which
+//   are on their way out and spend this window's budget;
 // - `carry` is what earlier windows sent beyond what the server has decoded since,
 //   at 5 per elapsed tick.
 //
-// The count errs high: a packet the server refuses spends no user slot, and an
-// action that is acknowledged a window late is booked to the later one. Erring
-// high costs at most the one-tick wait the runner would otherwise have taken.
+// An action costs the user events the browser client writes for it (userEventsOf,
+// shared with the in-page runtime): a click the client routes is two, MOVE_OPCLICK
+// then the op, and one sent with `route: false` is the op alone.
+//
+// The count errs high: a packet the server refuses spends no user slot, an action
+// that is acknowledged a window late is booked to the later one, and a routed click
+// for which the client found no route goes out as the op alone but is booked as two.
+// Erring high costs at most the one-tick wait the runner would otherwise have taken.
 
+import { userEventsOf } from '../../server/webclient/src/bot/programs/runtime';
 import { patchMethod } from './fence';
 
 export const USER_EVENTS_PER_TICK = 5;
@@ -58,13 +64,13 @@ export class TickWindow {
         this.openedAt = now;
     }
 
-    dispatched(): void {
-        this.pending++;
+    dispatched(events = 1): void {
+        this.pending += events;
     }
 
-    acknowledged(): void {
-        this.pending = Math.max(0, this.pending - 1);
-        this.sent++;
+    acknowledged(events = 1): void {
+        this.pending = Math.max(0, this.pending - events);
+        this.sent += events;
     }
 
     /** User events this window can still send that the server decodes on its next tick. */
@@ -85,7 +91,7 @@ export class TickWindow {
 type Dispatch = (action: unknown) => Promise<unknown>;
 
 /**
- * Book every action `sdk` dispatches into `window` until the returned function
+ * Book every action `sdk` dispatches into `window`, at its user events, until the returned function
  * is called. Every SDK send, raw or through `BotActions`, goes through the one
  * dispatch method BotSDK keeps private as `sendAction` (sdk/index.ts), so this
  * wraps it on the instance; it throws if that method is missing rather than
@@ -100,9 +106,10 @@ export function meterDispatch(sdk: object, window: TickWindow): () => void {
     return patchMethod(sdk, 'sendAction', (send: Dispatch) => (action: unknown) => {
         const type = (action as { type?: unknown } | null)?.type;
         if (typeof type === 'string' && NO_PACKET.has(type)) return send(action);
-        window.dispatched();
+        const events = typeof type === 'string' ? userEventsOf(action as { type: string; route?: boolean }) : 1;
+        window.dispatched(events);
         const p = send(action);
-        const settle = () => window.acknowledged();
+        const settle = () => window.acknowledged(events);
         p.then(settle, settle);
         return p;
     });
